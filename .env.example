# Copy this file to .env and adjust as needed.

APP_NAME=UpWise API
ENVIRONMENT=development

# SQLite by default (zero setup for the demo). For production, point this at
# Postgres/Supabase, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/upwise
DATABASE_URL=sqlite:///./upwise.db

# Change this in any real deployment.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: without this key, AI features automatically fall back to
# deterministic rule-based logic (see app/ai.py) so the demo never breaks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list, or "*" for all origins (default, fine for a hackathon demo).
CORS_ORIGINS=*

# Seeds demo data (categories, tools, admin + demo business, mock customers/campaigns)
# on first startup when the DB is empty.
SEED_ON_STARTUP=true
